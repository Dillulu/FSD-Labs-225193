<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
    <meta charset="utf-8">
    <title>Interactive Product Configurator - Submission</title>
    <!--[if gte mso 9]>
    <xml>
        <w:WordDocument>
            <w:View>Print</w:View>
            <w:Zoom>100</w:Zoom>
            <w:DoNotOptimizeForBrowser/>
        </w:WordDocument>
    </xml>
    <![endif]-->
    <style>
        body { font-family: Calibri, sans-serif; font-size: 11pt; }
        h1 { font-size: 16pt; color: #2F5496; }
        h2 { font-size: 14pt; color: #2F5496; margin-top: 20px; }
        .code-block { 
            font-family: Consolas, 'Courier New', monospace; 
            font-size: 9.5pt; 
            background-color: #F3F3F3; 
            padding: 10px; 
            border: 1px solid #D9D9D9; 
            white-space: pre-wrap; 
        }
        .instruction { color: red; font-weight: bold; }
    </style>
</head>
<body>
    <h1>Interactive Product Configurator - Lab Submission</h1>
    <p><strong>Course:</strong> Full Stack Development (CS-301L)</p>

    <h2>1. Output / Screenshots</h2>
    <p class="instruction">[Please insert the screenshots of your working Interactive Product Configurator here]</p>
    <br><br><br>

    <h2>2. HTML Code (index.html)</h2>
    <div class="code-block">
&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
    &lt;meta charset="UTF-8"&gt;
    &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
    &lt;title&gt;Interactive Product Configurator&lt;/title&gt;
    &lt;link rel="stylesheet" href="styles.css"&gt;
    &lt;link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&amp;display=swap" rel="stylesheet"&gt;
&lt;/head&gt;
&lt;body&gt;

&lt;header&gt;
    &lt;h1&gt;Premium Tech Accessories&lt;/h1&gt;
&lt;/header&gt;

&lt;main class="container"&gt;
    &lt;div class="product-configurator"&gt;
        &lt;!-- Product Information --&gt;
        &lt;section class="product-info"&gt;
            &lt;h2 id="product-name"&gt;Custom Smart Mug&lt;/h2&gt;
            &lt;p id="product-price"&gt;$89.99&lt;/p&gt;
            &lt;div class="description-container"&gt;
                &lt;p id="product-description"&gt;
                    Experience your beverages at the perfect temperature all day. This smart mug pairs with your device and features premium ceramic coating. 
                    (Note: This description is protected from copying).
                &lt;/p&gt;
                &lt;span id="copy-warning" class="hidden"&gt;Copying is disabled for this text.&lt;/span&gt;
            &lt;/div&gt;
        &lt;/section&gt;

        &lt;!-- Configuration Controls --&gt;
        &lt;section class="controls"&gt;
            &lt;form id="config-form"&gt;
                &lt;div class="form-group"&gt;
                    &lt;label for="theme-select"&gt;Select Color Theme:&lt;/label&gt;
                    &lt;select id="theme-select" name="theme"&gt;
                        &lt;option value="midnight"&gt;Midnight Black&lt;/option&gt;
                        &lt;option value="pearl"&gt;Pearl White&lt;/option&gt;
                        &lt;option value="ocean"&gt;Ocean Blue&lt;/option&gt;
                        &lt;option value="sunset"&gt;Sunset Orange&lt;/option&gt;
                    &lt;/select&gt;
                &lt;/div&gt;

                &lt;div class="form-group"&gt;
                    &lt;label for="engraving-input"&gt;Custom Engraving (Max 15 characters):&lt;/label&gt;
                    &lt;input type="text" id="engraving-input" name="engraving" maxlength="15" placeholder="Enter your name..."&gt;
                    &lt;small id="char-count"&gt;0/15 characters&lt;/small&gt;
                    &lt;span id="focus-feedback" class="hidden"&gt;Typing...&lt;/span&gt;
                &lt;/div&gt;

                &lt;div class="form-actions"&gt;
                    &lt;button type="submit" id="submit-btn"&gt;Save Configuration&lt;/button&gt;
                    &lt;button type="button" id="reset-btn"&gt;Reset&lt;/button&gt;
                &lt;/div&gt;
            &lt;/form&gt;
            &lt;div id="form-feedback" class="hidden"&gt;&lt;/div&gt;
        &lt;/section&gt;
    &lt;/div&gt;

    &lt;!-- Product Preview &amp; Cart --&gt;
    &lt;div class="interaction-area"&gt;
        &lt;!-- Interactive Preview --&gt;
        &lt;section class="preview-container"&gt;
            &lt;h3&gt;Live Preview&lt;/h3&gt;
            &lt;div id="product-preview" class="product-preview midnight" draggable="true"&gt;
                &lt;div class="mug-body"&gt;
                    &lt;div id="preview-engraving" class="engraving-text"&gt;&lt;/div&gt;
                    &lt;div class="mug-reflection"&gt;&lt;/div&gt;
                &lt;/div&gt;
                &lt;div class="mug-handle"&gt;&lt;/div&gt;
                
                &lt;!-- Tooltip for hover interaction --&gt;
                &lt;div id="hover-tooltip" class="hidden"&gt;Drag me to cart!&lt;/div&gt;
            &lt;/div&gt;
            &lt;p class="instruction-text"&gt;Hover to inspect, drag to cart.&lt;/p&gt;
        &lt;/section&gt;

        &lt;!-- Cart / Drop Area --&gt;
        &lt;section class="cart-section"&gt;
            &lt;h3&gt;Your Cart&lt;/h3&gt;
            &lt;div id="cart-drop-zone" class="drop-zone"&gt;
                &lt;p&gt;Drop Product Here&lt;/p&gt;
            &lt;/div&gt;
            &lt;div id="cart-summary" class="hidden"&gt;
                &lt;h4&gt;Cart Items&lt;/h4&gt;
                &lt;ul id="cart-items"&gt;&lt;/ul&gt;
            &lt;/div&gt;
        &lt;/section&gt;
    &lt;/div&gt;
&lt;/main&gt;

&lt;script src="script.js"&gt;&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;
    </div>

    <h2>3. CSS Code (styles.css)</h2>
    <div class="code-block">
:root {
    --bg-color: #0f172a;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --accent-color: #3b82f6;
    --accent-hover: #2563eb;
    --card-bg: #1e293b;
    --border-color: #334155;
    
    --midnight: #1e1e1e;
    --pearl: #f1f5f9;
    --ocean: #0ea5e9;
    --sunset: #f97316;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-primary);
    line-height: 1.6;
    overflow-x: hidden;
}

header {
    background-color: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(10px);
    padding: 20px;
    text-align: center;
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
}

.container {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
}

/* Sections */
.product-configurator, .interaction-area {
    background-color: var(--card-bg);
    border-radius: 16px;
    padding: 30px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    border: 1px solid var(--border-color);
}

.product-info h2 {
    font-size: 2rem;
    margin-bottom: 10px;
}

.product-info #product-price {
    font-size: 1.5rem;
    color: var(--accent-color);
    font-weight: 600;
    margin-bottom: 15px;
}

.description-container {
    position: relative;
    margin-bottom: 30px;
    color: var(--text-secondary);
}

.description-container p {
    user-select: none;
}

.hidden {
    display: none !important;
    opacity: 0;
}

#copy-warning {
    color: #ef4444;
    font-size: 0.875rem;
    display: block;
    margin-top: 5px;
    transition: opacity 0.3s ease;
}

/* Form Controls */
.form-group {
    margin-bottom: 25px;
    position: relative;
}

label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
}

select, input[type="text"] {
    width: 100%;
    padding: 12px 16px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background-color: var(--bg-color);
    color: var(--text-primary);
    font-size: 1rem;
    transition: all 0.3s ease;
    font-family: inherit;
}

select:focus, input[type="text"]:focus {
    outline: none;
    border-color: var(--accent-color);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
}

#char-count {
    display: block;
    text-align: right;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 5px;
}

#focus-feedback {
    position: absolute;
    right: 10px;
    top: -20px;
    font-size: 0.8rem;
    color: var(--accent-color);
    animation: pulse 1.5s infinite;
}

.form-actions {
    display: flex;
    gap: 15px;
    margin-top: 30px;
}

button {
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
    flex: 1;
}

#submit-btn {
    background-color: var(--accent-color);
    color: white;
}

#submit-btn:hover {
    background-color: var(--accent-hover);
    transform: translateY(-2px);
}

#reset-btn {
    background-color: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-color);
}

#reset-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

#form-feedback {
    margin-top: 15px;
    padding: 10px;
    border-radius: 8px;
    text-align: center;
    background-color: rgba(34, 197, 94, 0.2);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.3);
}

/* Interactive Preview */
.preview-container {
    text-align: center;
    margin-bottom: 40px;
}

.product-preview {
    width: 250px;
    height: 300px;
    margin: 20px auto;
    position: relative;
    cursor: grab;
    transition: transform 0.2s ease-out, filter 0.3s ease;
    perspective: 1000px;
}

.product-preview:active {
    cursor: grabbing;
}

.mug-body {
    width: 180px;
    height: 250px;
    border-radius: 10px 10px 30px 30px;
    position: absolute;
    left: 20px;
    top: 25px;
    box-shadow: inset -20px 0 40px rgba(0,0,0,0.5), 10px 10px 20px rgba(0,0,0,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: background-color 0.5s ease;
}

.mug-reflection {
    position: absolute;
    top: 0;
    left: 10%;
    width: 20%;
    height: 100%;
    background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.3) 50%, rgba(255,255,255,0) 100%);
    pointer-events: none;
}

.mug-handle {
    width: 60px;
    height: 120px;
    border: 15px solid;
    border-left: none;
    border-radius: 0 40px 40px 0;
    position: absolute;
    right: 0px;
    top: 70px;
    z-index: -1;
    transition: border-color 0.5s ease;
}

/* Themes */
.product-preview.midnight .mug-body { background-color: var(--midnight); }
.product-preview.midnight .mug-handle { border-color: var(--midnight); }
.product-preview.midnight .engraving-text { color: rgba(255,255,255,0.8); }

.product-preview.pearl .mug-body { background-color: var(--pearl); }
.product-preview.pearl .mug-handle { border-color: var(--pearl); }
.product-preview.pearl .engraving-text { color: rgba(0,0,0,0.8); }

.product-preview.ocean .mug-body { background-color: var(--ocean); }
.product-preview.ocean .mug-handle { border-color: var(--ocean); }
.product-preview.ocean .engraving-text { color: rgba(255,255,255,0.9); }

.product-preview.sunset .mug-body { background-color: var(--sunset); }
.product-preview.sunset .mug-handle { border-color: var(--sunset); }
.product-preview.sunset .engraving-text { color: rgba(255,255,255,0.9); }

.engraving-text {
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 2px;
    z-index: 2;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
    word-break: break-all;
    padding: 0 20px;
    text-align: center;
}

#hover-tooltip {
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255,255,255,0.9);
    color: black;
    padding: 5px 10px;
    border-radius: 5px;
    font-size: 0.8rem;
    pointer-events: none;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.product-preview:hover #hover-tooltip {
    opacity: 1;
    display: block !important;
}

.product-preview.hover-effect {
    filter: brightness(1.2);
}

.instruction-text {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-top: 10px;
}

/* Cart Drop Zone */
.cart-section {
    border-top: 1px solid var(--border-color);
    padding-top: 30px;
}

.drop-zone {
    border: 2px dashed var(--border-color);
    border-radius: 12px;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 15px;
    transition: all 0.3s ease;
    background-color: rgba(0, 0, 0, 0.2);
}

.drop-zone.drag-over {
    border-color: var(--accent-color);
    background-color: rgba(59, 130, 246, 0.1);
    transform: scale(1.02);
}

.drop-zone p {
    color: var(--text-secondary);
    font-size: 1.2rem;
    pointer-events: none;
}

#cart-summary {
    margin-top: 20px;
    background-color: rgba(255,255,255,0.05);
    padding: 15px;
    border-radius: 8px;
}

#cart-items {
    list-style-type: none;
    margin-top: 10px;
}

#cart-items li {
    padding: 8px 0;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
}

@keyframes pulse {
    0% { opacity: 0.5; }
    50% { opacity: 1; }
    100% { opacity: 0.5; }
}

@media (max-width: 900px) {
    .container {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .product-preview {
        transform: scale(0.8);
    }
}
    </div>

    <h2>4. JavaScript Code (script.js)</h2>
    <div class="code-block">
document.addEventListener('DOMContentLoaded', () =&gt; {
    // 1. Elements Selection
    const descriptionText = document.getElementById('product-description');
    const copyWarning = document.getElementById('copy-warning');
    const themeSelect = document.getElementById('theme-select');
    const engravingInput = document.getElementById('engraving-input');
    const charCount = document.getElementById('char-count');
    const focusFeedback = document.getElementById('focus-feedback');
    const productPreview = document.getElementById('product-preview');
    const previewEngraving = document.getElementById('preview-engraving');
    const mugReflection = document.querySelector('.mug-reflection');
    const dropZone = document.getElementById('cart-drop-zone');
    const cartSummary = document.getElementById('cart-summary');
    const cartItems = document.getElementById('cart-items');
    const configForm = document.getElementById('config-form');
    const formFeedback = document.getElementById('form-feedback');
    const resetBtn = document.getElementById('reset-btn');
    const hoverTooltip = document.getElementById('hover-tooltip');

    let cart = [];

    // --- EVENT LISTENERS ---

    // Event 1 &amp; 2: Copy and Cut
    const preventCopyCut = (e) =&gt; {
        e.preventDefault();
        copyWarning.classList.remove('hidden');
        copyWarning.style.opacity = '1';
        setTimeout(() =&gt; {
            copyWarning.style.opacity = '0';
            setTimeout(() =&gt; copyWarning.classList.add('hidden'), 300);
        }, 2000);
    };
    descriptionText.addEventListener('copy', preventCopyCut);
    descriptionText.addEventListener('cut', preventCopyCut);

    // Event 3: Change
    themeSelect.addEventListener('change', (e) =&gt; {
        productPreview.classList.remove('midnight', 'pearl', 'ocean', 'sunset');
        productPreview.classList.add(e.target.value);
    });

    // Event 4: Input
    engravingInput.addEventListener('input', (e) =&gt; {
        const text = e.target.value;
        previewEngraving.textContent = text;
        charCount.textContent = `${text.length}/15 characters`;
    });

    // Event 5 &amp; 6: Focus and Blur
    engravingInput.addEventListener('focus', () =&gt; {
        focusFeedback.classList.remove('hidden');
    });
    engravingInput.addEventListener('blur', () =&gt; {
        focusFeedback.classList.add('hidden');
    });

    // Event 7 &amp; 8: Mouseenter and Mouseleave
    productPreview.addEventListener('mouseenter', () =&gt; {
        productPreview.classList.add('hover-effect');
        hoverTooltip.classList.remove('hidden');
    });
    productPreview.addEventListener('mouseleave', () =&gt; {
        productPreview.classList.remove('hover-effect');
        hoverTooltip.classList.add('hidden');
        productPreview.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)`;
    });

    // Event 9: Mousemove (Interactive 3D Effect)
    productPreview.addEventListener('mousemove', (e) =&gt; {
        const rect = productPreview.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -15;
        const rotateY = ((x - centerX) / centerX) * 15;
        
        productPreview.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.05)`;
        
        const reflectionOffset = ((x / rect.width) * 100) - 50;
        mugReflection.style.transform = `translateX(${reflectionOffset}px)`;
    });

    // Event 10: Dragstart
    productPreview.addEventListener('dragstart', (e) =&gt; {
        const productData = {
            theme: themeSelect.value,
            engraving: engravingInput.value || 'None'
        };
        e.dataTransfer.setData('application/json', JSON.stringify(productData));
        e.dataTransfer.effectAllowed = 'copy';
        setTimeout(() =&gt; { productPreview.style.opacity = '0.5'; }, 0);
    });

    productPreview.addEventListener('dragend', () =&gt; {
        productPreview.style.opacity = '1';
        dropZone.classList.remove('drag-over');
    });

    // Event 11: Dragover
    dropZone.addEventListener('dragover', (e) =&gt; {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'copy';
        dropZone.classList.add('drag-over');
    });

    // Event 12: Dragleave
    dropZone.addEventListener('dragleave', () =&gt; {
        dropZone.classList.remove('drag-over');
    });

    // Event 13: Drop
    dropZone.addEventListener('drop', (e) =&gt; {
        e.preventDefault();
        dropZone.classList.remove('drag-over');
        try {
            const data = JSON.parse(e.dataTransfer.getData('application/json'));
            addToCart(data);
            dropZone.innerHTML = '&lt;p style="color: #4ade80;"&gt;Added to Cart! ✅&lt;/p&gt;';
            setTimeout(() =&gt; { dropZone.innerHTML = '&lt;p&gt;Drop Product Here&lt;/p&gt;'; }, 2000);
        } catch (error) {
            console.error('Error parsing dragged data', error);
        }
    });

    // Event 14: Submit
    configForm.addEventListener('submit', (e) =&gt; {
        e.preventDefault();
        const selectedThemeText = themeSelect.options[themeSelect.selectedIndex].text;
        const engraving = engravingInput.value.trim() || 'None';
        formFeedback.textContent = `Configuration Saved! Theme: ${selectedThemeText}, Engraving: ${engraving}`;
        formFeedback.classList.remove('hidden');
        setTimeout(() =&gt; { formFeedback.classList.add('hidden'); }, 4000);
    });

    // Event 15: Reset
    resetBtn.addEventListener('click', () =&gt; {
        configForm.reset();
        productPreview.className = 'product-preview midnight';
        previewEngraving.textContent = '';
        charCount.textContent = '0/15 characters';
        formFeedback.classList.add('hidden');
        copyWarning.classList.add('hidden');
        cart = [];
        updateCartDisplay();
        
        dropZone.innerHTML = '&lt;p style="color: #3b82f6;"&gt;Reset Successful 🔄&lt;/p&gt;';
        setTimeout(() =&gt; { dropZone.innerHTML = '&lt;p&gt;Drop Product Here&lt;/p&gt;'; }, 2000);
    });

    // Event 16: Scroll
    window.addEventListener('scroll', () =&gt; {
        const header = document.querySelector('header');
        if (window.scrollY &gt; 50) {
            header.style.boxShadow = '0 4px 10px rgba(0,0,0,0.5)';
        } else {
            header.style.boxShadow = 'none';
        }
    });

    // Helper Functions
    function addToCart(product) {
        cart.push(product);
        updateCartDisplay();
    }

    function updateCartDisplay() {
        if (cart.length &gt; 0) {
            cartSummary.classList.remove('hidden');
            cartItems.innerHTML = '';
            cart.forEach((item, index) =&gt; {
                const li = document.createElement('li');
                const themeName = item.theme.charAt(0).toUpperCase() + item.theme.slice(1);
                li.innerHTML = `&lt;span&gt;Mug (${themeName})&lt;/span&gt;&lt;span&gt;Text: ${item.engraving}&lt;/span&gt;`;
                cartItems.appendChild(li);
            });
        } else {
            cartSummary.classList.add('hidden');
        }
    }
});
    </div>
</body>
</html>
